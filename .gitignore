# Индекс чужого содержимого: собирается локально командой build-index,
# содержит описания предметов системы и других модулей — в репозитории ему не место.
tools/index.json

# Черновики и временное.
drafts/
# Только в корне: у LevelDB свежие записи лежат в файле вида `000171.log`
# внутри пака, и правило `*.log` уносило их мимо репозитория и мимо архива
# релиза — пак уезжал пользователю без последних добавленных предметов.
/*.log

# Архив релиза: собирается командой make_release.
module.zip

# Выгрузка предметов из компендиумов системы: собирается локально командой
# extract-pa-items, содержит чужие документы целиком — в репозитории ей не место.
# Импортёр силовой брони требует её как заготовку, поэтому перед сборкой
# исходников выполняется `node tools/extract-pa-items.js`.
docs/power-armor-items.json
